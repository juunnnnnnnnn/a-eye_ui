{
  "expo": {
    "name": "A-EYE",
    "slug": "a-eye",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/aeye-icon.png",
    "scheme": "aeye",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/aeye-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#F6F8FC"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.aeye.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "AI 이미지 판별을 위해 사진을 촬영할 때 카메라를 사용합니다. 촬영한 이미지는 분석 목적으로만 처리됩니다.",
        "NSPhotoLibraryUsageDescription": "분석할 이미지를 선택하기 위해 사진 라이브러리에 접근합니다. 선택한 이미지는 분석 목적으로만 처리됩니다.",
        "ITSAppUsesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      }
    },
    "android": {
      "package": "com.aeye.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/aeye-adaptive-icon.png",
        "backgroundColor": "#F6F8FC"
      },
      "permissions": [
        "CAMERA",
        "READ_EXTERNAL_STORAGE"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "AI 이미지 판별을 위해 사진을 촬영할 때 카메라를 사용합니다.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "분석할 이미지를 선택하기 위해 사진 라이브러리에 접근합니다."
        }
      ],
      "expo-font"
    ],
    "extra": {
      "defaultBackendUrl": "https://wonjun12-aeye-backend.hf.space",
      "eas": {
        "projectId": "TO_BE_FILLED_BY_EAS_INIT"
      }
    }
  }
}
